# Production build
NEXT_PUBLIC_IS_PRODUCTION=

# Latest supported safe version, used for upgrade prompts
NEXT_PUBLIC_SAFE_VERSION=

# Wallet-specific variables
NEXT_PUBLIC_WC_PROJECT_ID=

# Historical RPC log block range batch size (defaults to 10000, clamped to 500..50000)
NEXT_PUBLIC_HISTORICAL_RPC_LOG_BLOCK_BATCH_SIZE=10000

# Historical RPC max concurrent batched log requests (defaults to 10)
NEXT_PUBLIC_HISTORICAL_RPC_LOG_MAX_CONCURRENT_REQUESTS=10
